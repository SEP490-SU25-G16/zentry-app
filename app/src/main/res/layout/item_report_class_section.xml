<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="0dp"
    app:cardElevation="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:minHeight="120dp">

        <!-- Subject Title -->
        <TextView
            android:id="@+id/tvSubject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:text="Mathematics -G701"
            android:textColor="#1A1D29"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/mulishextrabold"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginEnd="100dp" />

        <!-- Students Count Badge -->
        <TextView
            android:id="@+id/tvStudentsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvSubject"
            android:layout_alignParentStart="true"
            android:layout_marginTop="12dp"
            android:text="20 Students"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/mulishbold"
            android:background="@drawable/bg_students_badge"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <!-- Sessions Count Badge -->
        <TextView
            android:id="@+id/tvSessionsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvStudentsCount"
            android:layout_alignParentStart="true"
            android:layout_marginTop="8dp"
            android:text="15/20 Sessions"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="@font/mulishbold"
            android:background="@drawable/bg_sessions_badge"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <!-- Attendance Percentage Circle -->
        <LinearLayout
            android:id="@+id/attendanceContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvAttendancePercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="90%"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/mulishextrabold"
                android:background="@drawable/bg_attendance_circle"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avg attendance %"
                android:textColor="#6B7280"
                android:textSize="10sp"
                android:fontFamily="@font/mulishbold"
                android:gravity="center"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
