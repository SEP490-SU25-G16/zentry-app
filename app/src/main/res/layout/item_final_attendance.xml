<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/ivStudentAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_student"
        android:scaleType="centerCrop"
        android:background="@drawable/circle_background" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvStudentName"
            android:fontFamily="@font/jostsemibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#232B42" />

        <TextView
            android:id="@+id/tvStudentCode"
            android:fontFamily="@font/mulishbold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID: ST001324"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvAttendanceRatio"
            android:fontFamily="@font/mulishbold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3/4 rounds"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAttendanceStatus"
        android:fontFamily="@font/jostsemibold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Attended"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#4CAF50" />

</LinearLayout>
