<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="0dp"
    app:cardElevation="6dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStudentName"
                android:fontFamily="@font/jostsemibold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A1D29"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvStudentCode"
                android:fontFamily="@font/mulishbold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: ST001324"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvAttendanceRatio"
                android:fontFamily="@font/mulishbold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3/4 rounds"
                android:textSize="13sp"
                android:textColor="#374151"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvAttendanceStatus"
            android:fontFamily="@font/jostsemibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Attended"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#059669"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
