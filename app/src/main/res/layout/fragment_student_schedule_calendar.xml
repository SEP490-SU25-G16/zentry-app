<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flStudentScheduleCalendarRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F5F9FF">

    <!-- ScrollView chứa toàn bộ content, đẩy xuống dưới toolbar overlay -->
    <ScrollView
        android:id="@+id/svStudentScheduleCalendarContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:paddingTop="?attr/actionBarSize"
        android:background="@android:color/transparent">

        <LinearLayout
            android:id="@+id/llStudentScheduleCalendarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="vertical">

            <!-- Calendar Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStudentScheduleCalendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#A3BBFF">

                <CalendarView
                    android:id="@+id/calendarView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weekSeparatorLineColor="@android:color/transparent"
                    android:focusedMonthDateColor="#FFFFFF"
                    android:unfocusedMonthDateColor="#E0E0E0"
                    android:selectedWeekBackgroundColor="#CAE0FF"
                    android:weekDayTextAppearance="@style/CalendarWeekDay"
                    android:dateTextAppearance="@style/CalendarDate"
                    />
            </com.google.android.material.card.MaterialCardView>

            <!-- Timeline Section -->
            <LinearLayout
                android:id="@+id/llStudentScheduleCalendarTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Item 1 -->
                <LinearLayout
                    android:id="@+id/llStudentScheduleCalendarItem1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:id="@+id/llStudentScheduleCalendarItem1Indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <View
                            android:id="@+id/viewStudentScheduleCalendarItem1Circle"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/circle_pink" />
                        <View
                            android:id="@+id/viewStudentScheduleCalendarItem1Line"
                            android:layout_width="2dp"
                            android:layout_height="40dp"
                            android:background="#FF4081" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStudentScheduleCalendarItem1Time"
                        android:fontFamily="@font/poppinslight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="08:00"
                        android:textSize="14sp"
                        android:textColor="#232B42" />

                    <TextView
                        android:id="@+id/tvStudentScheduleCalendarItem1Description"
                        android:fontFamily="@font/poppinslight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="Math Class: Grade 07"
                        android:textSize="14sp"
                        android:textColor="#666666" />
                </LinearLayout>

                <!-- Item 2 -->
                <LinearLayout
                    android:id="@+id/llStudentScheduleCalendarItem2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:id="@+id/llStudentScheduleCalendarItem2Indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <View
                            android:id="@+id/viewStudentScheduleCalendarItem2Circle"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/circle_pink" />
                        <View
                            android:id="@+id/viewStudentScheduleCalendarItem2Line"
                            android:layout_width="2dp"
                            android:layout_height="40dp"
                            android:background="#FF4081" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStudentScheduleCalendarItem2Time"
                        android:fontFamily="@font/poppinslight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="09:30"
                        android:textSize="14sp"
                        android:textColor="#232B42" />

                    <TextView
                        android:id="@+id/tvStudentScheduleCalendarItem2Description"
                        android:fontFamily="@font/poppinslight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="Meeting at office"
                        android:textSize="14sp"
                        android:textColor="#666666" />
                </LinearLayout>

                <!-- Divider end of timeline -->
                <View
                    android:id="@+id/viewStudentScheduleCalendarDivider"
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="16dp"
                    android:background="#E0E0E0" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Toolbar custom overlay -->
    <LinearLayout
        android:id="@+id/llStudentScheduleCalendarToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@android:color/transparent"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/ivStudentScheduleCalendarBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="#232B42" />

        <TextView
            android:id="@+id/tvStudentScheduleCalendarTitle"
            android:fontFamily="@font/jostsemibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="My Classes"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#232B42" />
    </LinearLayout>
</FrameLayout>
