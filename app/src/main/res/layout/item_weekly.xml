<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:minHeight="120dp">

        <!-- Top row: Subject + Percentage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Subject title -->
            <TextView
                android:id="@+id/tvSubject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="English Grade - 07"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/mulishextrabold"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginEnd="12dp"/>

            <!-- Percentage -->
            <TextView
                android:id="@+id/tvAttendance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="90%"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/bg_rounded_purple"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Middle: Presented -->
        <TextView
            android:id="@+id/tvPresented"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="2/3 Presented"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/mulishextrabold"
            android:background="@drawable/bg_presented_rounded"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"/>

        <!-- Bottom: Sessions -->
        <TextView
            android:id="@+id/tvSessions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="19/20 Sessions"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:fontFamily="@font/mulishextrabold"
            android:background="@drawable/bg_presented_rounded"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
