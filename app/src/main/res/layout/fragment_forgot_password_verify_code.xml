<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flVerifyCodeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9FF"
    android:fitsSystemWindows="true">

    <!-- Content chính, paddingTop để lùi xuống dưới toolbar -->
    <LinearLayout
        android:id="@+id/llVerifyCodeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="?attr/actionBarSize">

        <!-- Thông báo đã gửi code -->
        <TextView
            android:id="@+id/tvVerifyCodeMessage"
            android:fontFamily="@font/mulishbold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center"
            android:text="Code has been sent to priscilla.frank******@gmail.com"
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- PinView để nhập OTP -->
        <com.chaos.view.PinView
            android:id="@+id/pvVerifyCodeInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"
            android:inputType="number"
            android:cursorVisible="true"
            app:itemHeight="56dp"
            app:itemRadius="12dp"
            app:itemSpacing="16dp"
            app:itemTextColor="#232B42"
            app:itemWidth="56dp"
            android:textSize="20sp" />

        <!-- Resend timer -->
        <TextView
            android:id="@+id/tvVerifyCodeResendTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Resend Code in 59s"
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- Spacer đẩy button xuống đáy -->
        <Space
            android:id="@+id/spVerifyCodeSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Button Verify -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerifyCodeVerify"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="50dp"
            android:fontFamily="@font/jostsemibold"
            android:paddingLeft="40dp"
            android:paddingEnd="7dp"
            android:text="Verify"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            app:backgroundTint="#156CF7"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_arrow_right"
            app:iconGravity="end"
            app:iconPadding="8dp"
            app:iconSize="40dp"
            app:iconTint="@null" />
    </LinearLayout>

    <!-- Toolbar custom overlay -->
    <LinearLayout
        android:id="@+id/llVerifyCodeToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/ivVerifyCodeBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#232B42" />

        <TextView
            android:id="@+id/tvVerifyCodeTitle"
            android:fontFamily="@font/jostsemibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Verify Code"
            android:textColor="#232B42"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
