<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flCreatePasswordRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9FF"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/llCreatePasswordContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="?attr/actionBarSize">

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvCreatePasswordSubtitle"
            android:layout_gravity="center"
            android:fontFamily="@font/jostsemibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="Create your new password"
            android:textColor="#232B42"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Password Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCreatePasswordNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#156CF7"
            app:endIconMode="password_toggle"
            app:endIconTint="#232B42"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="#232B42">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCreatePasswordNew"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Password"
                android:inputType="textPassword"
                android:paddingStart="40dp"
                android:textColor="#232B42"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Re-type Password Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCreatePasswordReType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#156CF7"
            app:endIconMode="password_toggle"
            app:endIconTint="#232B42"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="#232B42">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCreatePasswordReType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Re-type Password"
                android:inputType="textPassword"
                android:paddingStart="40dp"
                android:textColor="#232B42"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Spacer -->
        <Space
            android:id="@+id/spCreatePasswordSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Button Continue -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreatePasswordContinue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="50dp"
            android:paddingEnd="7dp"
            android:fontFamily="@font/jostsemibold"
            android:paddingLeft="47dp"
            android:text="Verify"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            app:backgroundTint="#156CF7"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_arrow_right"
            app:iconGravity="end"
            app:iconPadding="8dp"
            app:iconSize="40dp"
            app:iconTint="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llCreatePasswordToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/ivCreatePasswordBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#232B42" />

        <TextView
            android:id="@+id/tvCreatePasswordTitle"
            android:fontFamily="@font/jostsemibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Create New Password"
            android:textColor="#232B42"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
