<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flReportRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F5F9FF">

    <!-- ScrollView chứa toàn bộ content, paddingTop để lùi xuống dưới toolbar -->
    <ScrollView
        android:id="@+id/svReportContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:paddingTop="?attr/actionBarSize"
        android:background="@android:color/transparent">

        <LinearLayout
            android:id="@+id/llReportContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReportHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#FFFFFF"
                app:cardElevation="4dp">

                <LinearLayout
                    android:id="@+id/llReportHeaderContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvReportGrade"
                        android:fontFamily="@font/mulishbold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grade 07"
                        android:textColor="#F57C00"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvReportSubject"
                        android:fontFamily="@font/jostsemibold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Mathematics"
                        android:textColor="#232B42"
                        android:textSize="20sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:id="@+id/llReportStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:id="@+id/llReportStudents"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/ivReportStudentIcon"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_student"
                                app:tint="#202244" />

                            <TextView
                                android:id="@+id/tvReportStudentCount"
                                android:fontFamily="@font/mulishextrabold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="21 Students"
                                android:textSize="14sp"
                                android:textColor="#202244"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llReportSessions"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvReportSessionCount"
                                android:fontFamily="@font/mulishextrabold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12/20 Sessions"
                                android:textSize="14sp"
                                android:textColor="#202244"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvReportSessionListLabel"
                        android:fontFamily="@font/mulishextrabold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="SESSION LIST"
                        android:textColor="#202244"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <View
                        android:id="@+id/viewReportSessionDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="#E0E0E0"/>

                    <!-- Session Items -->
                    <LinearLayout
                        android:id="@+id/llReportSessionList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp">

                        <!-- Session 1 -->
                        <LinearLayout
                            android:id="@+id/llReportSession1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp">

                            <LinearLayout
                                android:id="@+id/llReportSession1Info"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvReportSession1Title"
                                    android:fontFamily="@font/mulishextrabold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Session - 1"
                                    android:textColor="#232B42"
                                    android:textSize="16sp"
                                    android:textStyle="bold"/>

                                <LinearLayout
                                    android:id="@+id/llReportSession1Details"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:layout_marginTop="4dp">

                                    <TextView
                                        android:id="@+id/tvReportSession1Attendance"
                                        android:fontFamily="@font/jostsemibold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="18/21 - Attendance"
                                        android:textSize="12sp"
                                        android:textColor="#666666"/>

                                    <TextView
                                        android:id="@+id/tvReportSession1Separator"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="16dp"
                                        android:text="|"
                                        android:textSize="12sp"
                                        android:textColor="#CCCCCC"/>

                                    <TextView
                                        android:id="@+id/tvReportSession1Date"
                                        android:fontFamily="@font/mulishextrabold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="16dp"
                                        android:text="01/01/2025"
                                        android:textSize="12sp"
                                        android:textColor="#979797"/>
                                </LinearLayout>
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/ivReportSession1Arrow"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_arrow_right_detail"
                                app:tint="#0961F5" />
                        </LinearLayout>

                        <View
                            android:id="@+id/viewReportSession1Divider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#949494"/>

                        <!-- Session 2 -->
                        <LinearLayout
                            android:id="@+id/llReportSession2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp">

                            <LinearLayout
                                android:id="@+id/llReportSession2Info"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvReportSession2Title"
                                    android:fontFamily="@font/mulishextrabold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Session - 2"
                                    android:textColor="#232B42"
                                    android:textSize="16sp"
                                    android:textStyle="bold"/>

                                <LinearLayout
                                    android:id="@+id/llReportSession2Details"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:layout_marginTop="4dp">

                                    <TextView
                                        android:id="@+id/tvReportSession2Attendance"
                                        android:fontFamily="@font/jostsemibold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="18/21 - Attendance"
                                        android:textSize="12sp"
                                        android:textColor="#666666"/>

                                    <TextView
                                        android:id="@+id/tvReportSession2Separator"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="16dp"
                                        android:text="|"
                                        android:textSize="12sp"
                                        android:textColor="#CCCCCC"/>

                                    <TextView
                                        android:id="@+id/tvReportSession2Date"
                                        android:fontFamily="@font/mulishextrabold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="16dp"
                                        android:text="02/01/2025"
                                        android:textSize="12sp"
                                        android:textColor="#666666"/>
                                </LinearLayout>
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/ivReportSession2Arrow"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_arrow_right_detail"
                                app:tint="#0961F5" />
                        </LinearLayout>

                        <View
                            android:id="@+id/viewReportSession2Divider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#949494"/>

                        <!-- ... thêm các session khác tương tự ... -->

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Toolbar custom overlay -->
    <LinearLayout
        android:id="@+id/llReportToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@android:color/transparent"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/ivReportBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="#232B42" />

        <TextView
            android:id="@+id/tvReportTitle"
            android:fontFamily="@font/jostsemibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="My Report"
            android:textColor="#232B42"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>
</FrameLayout>
