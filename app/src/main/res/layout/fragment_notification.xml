<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding_default"
    android:background="@color/white">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:tint="@color/primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />

        <TextView
            android:id="@+id/tvNotificationTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/notification_title"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:textColor="@color/primaryText"
            android:gravity="center" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:tint="@color/gray"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/settings" />
    </LinearLayout>

    <!-- Tab Layout -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabNotification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@android:color/transparent"
        app:tabIndicatorColor="@color/primary"
        app:tabMode="scrollable"
        app:tabGravity="center"
        app:tabTextColor="@color/gray"
        app:tabSelectedTextColor="@color/primary" />

    <!-- ViewPager2 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerNotification"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="56dp"
        android:overScrollMode="never" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/notificationEmptyState"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/image_empty_state"
            android:layout_height="@dimen/image_empty_state"
            android:src="@drawable/ic_notification_empty" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notification_empty"
            android:textSize="@dimen/text_size_normal"
            android:textColor="@color/gray"
            android:layout_marginTop="@dimen/margin_small" />

        <TextView
            android:id="@+id/tvNotificationHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notification_history_link"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_size_small"
            android:layout_marginTop="@dimen/margin_small" />
    </LinearLayout>
</LinearLayout>
