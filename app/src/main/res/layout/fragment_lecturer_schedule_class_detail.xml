<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flScheduleClassDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9FF"
    android:fitsSystemWindows="true">

    <!-- ScrollView với paddingTop để lùi xuống dưới toolbar cố định -->
    <ScrollView
        android:id="@+id/svScheduleClassDetailContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:padding="16dp"
        android:paddingTop="?attr/actionBarSize">

        <LinearLayout
            android:id="@+id/llScheduleClassDetailContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Class Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardScheduleClassDetailHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#FFFFFF"
                android:padding="0dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:id="@+id/llScheduleClassDetailHeaderContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header row: Grade/Subject + Add button -->
                    <LinearLayout
                        android:id="@+id/llScheduleClassDetailHeaderRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/llScheduleClassDetailGradeSubject"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvScheduleClassDetailGrade"
                                android:fontFamily="@font/mulishbold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tên lớp"
                                android:textColor="#F57C00"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvScheduleClassDetailSubject"
                                android:fontFamily="@font/jostsemibold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Tên môn học"
                                android:textColor="#232B42"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/btnScheduleClassDetailAdd"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/circle_background"
                            android:contentDescription="Add"
                            android:src="@drawable/ic_add" />
                    </LinearLayout>

                    <!-- Stats row -->
                    <LinearLayout
                        android:id="@+id/llScheduleClassDetailStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/llScheduleClassDetailStudents"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivScheduleClassDetailStudentIcon"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_student"
                                app:tint="#202244" />

                            <TextView
                                android:id="@+id/tvScheduleClassDetailStudentCount"
                                android:fontFamily="@font/mulishextrabold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="21 Students"
                                android:textColor="#202244"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llScheduleClassDetailDurationContainer"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvScheduleClassDetailDurationLabel"
                                android:fontFamily="@font/mulishextrabold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Duration 2h30"
                                android:textColor="#202244"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvScheduleClassDetailDuration"
                            android:fontFamily="@font/mulishextrabold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:14:50"
                            android:textColor="#979797"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Tabs + ViewPager -->
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayoutScheduleClassDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:tabIndicatorColor="#0961F5"
                        app:tabSelectedTextColor="#232B42"
                        app:tabTextColor="#666666" />

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewPagerScheduleClassDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Toolbar custom overlay -->
    <LinearLayout
        android:id="@+id/llScheduleClassDetailToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/ivScheduleClassDetailBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#232B42" />

        <TextView
            android:id="@+id/tvScheduleClassDetailTitle"
            android:fontFamily="@font/jostsemibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="My Classes"
            android:textColor="#232B42"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnScheduleClassDetailNotification"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_notification" />
    </LinearLayout>
</FrameLayout>
