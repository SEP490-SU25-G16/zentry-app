<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSessionTitle"
            android:fontFamily="@font/mulishextrabold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Session - 1"
            android:textColor="#232B42"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvSessionAttendance"
                android:fontFamily="@font/jostsemibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18/21 - Attendance"
                android:textSize="12sp"
                android:textColor="#666666"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="|"
                android:textSize="12sp"
                android:textColor="#CCCCCC"/>

            <TextView
                android:id="@+id/tvSessionDate"
                android:fontFamily="@font/mulishextrabold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="01/01/2025"
                android:textSize="12sp"
                android:textColor="#979797"/>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/ivSessionArrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_arrow_right_detail"
        app:tint="#0961F5" />

</LinearLayout>
