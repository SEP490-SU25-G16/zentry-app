<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:gravity="top">

        <!-- Left content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/tvSessionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="English Grade - 07"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:fontFamily="@font/mulishextrabold"
                android:textSize="16sp"
                android:maxLines="3"/>

            <TextView
                android:id="@+id/tvSessionSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mulishbold"
                android:text="Saturday 10.00 - 12.00 pm"
                android:textColor="@color/bodyText"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:maxLines="2"/>
        </LinearLayout>

        <!-- Right timer -->
        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="02:15:45"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/countdownTimer"
            android:background="@drawable/bg_timer_rounded"
            android:padding="10dp"
            android:gravity="center"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
