<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvRoundTitle"
                android:fontFamily="@font/jostsemibold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Round 1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#232B42" />

            <TextView
                android:id="@+id/tvRoundDate"
                android:fontFamily="@font/mulishbold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15/12/2024"
                android:textSize="12sp"
                android:textColor="#666666" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvRoundTime"
                android:fontFamily="@font/mulishbold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:30"
                android:textSize="14sp"
                android:textColor="#666666" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvRoundAttendance"
                android:fontFamily="@font/jostsemibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25/30 attended"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#4CAF50" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressRoundAttendance"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:progress="83"
            android:progressTint="#4CAF50" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
