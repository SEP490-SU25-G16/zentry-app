<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/faceIdRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F5F9FF">

    <!-- 1) Content chính, paddingTop để lùi xuống dưới toolbar overlay -->
    <LinearLayout
        android:id="@+id/faceIdContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="?attr/actionBarSize"
        android:background="@android:color/transparent">

        <!-- Avatar & Update Time (centered) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Avatar Image -->
            <ImageView
                android:id="@+id/ivFaceAvatar"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginTop="48dp"
                android:background="@drawable/bg_circle_white"
                android:elevation="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_notification" />

            <!-- Last update -->
            <TextView
                android:id="@+id/tvLastUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:fontFamily="@font/mulishbold"
                android:text="Last update: JAN 27, 2025   /   11:45"
                android:textColor="#232B42"
                android:textSize="14sp" />

            <!-- Update Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdateFace"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:text="Update"
                android:fontFamily="@font/jostextrabold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="17sp"
                android:elevation="6dp"
                app:backgroundTint="#AEACF5"
                app:cornerRadius="28dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 2) Toolbar custom overlay -->
    <LinearLayout
        android:id="@+id/customToolbarFaceId"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@android:color/transparent"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="#232B42"/>

        <TextView
            android:fontFamily="@font/jostsemibold"

            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Face ID"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#232B42"/>
    </LinearLayout>
</FrameLayout>
