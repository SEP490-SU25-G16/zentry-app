<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#FFFFFF"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivSessionIcon"
            android:layout_gravity="center"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:padding="20dp"
            android:src="@drawable/ic_congratulations"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvSessionTitle"
                android:fontFamily="@font/circularstdmedium500"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Session Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#232B42" />

            <TextView
                android:id="@+id/tvSessionClassInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Class - Room"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvSessionTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:00 - 09:30"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvSessionAttendance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attendance - 100%"
                android:textSize="12sp"
                android:textColor="#4C4B4B"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvSessionTaskSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tasks completed"
                android:textSize="12sp"
                android:textColor="#4C4B4B"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <ProgressBar
                android:id="@+id/pbSessionProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="4dp"
                android:progress="0"
                android:progressDrawable="@drawable/rounded_progressbar"
                android:progressTint="#0961F5" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
