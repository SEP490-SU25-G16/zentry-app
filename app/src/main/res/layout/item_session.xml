<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="0dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvSessionTitle"
            android:fontFamily="@font/circularstdmedium500"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Session Name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A1D29"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvSessionClassInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Class - Room"
            android:textSize="14sp"
            android:textColor="#6B7280"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvSessionTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="08:00 - 09:30"
            android:textSize="13sp"
            android:textColor="#374151"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSessionAttendance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Attendance - 100%"
                android:textSize="12sp"
                android:textColor="#059669"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSessionTaskSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tasks completed"
                android:textSize="13sp"
                android:textColor="#374151"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProgressPercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="12sp"
                android:textColor="#0961F5"
                android:textStyle="bold" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbSessionProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:progress="0"
            android:progressDrawable="@drawable/rounded_progressbar"
            android:progressTint="#0961F5" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
