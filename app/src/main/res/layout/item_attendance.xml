<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="0dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <!-- Circle với số thứ tự student -->
        <TextView
            android:id="@+id/tvStudentNumber"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/circle_background_round"
            android:fontFamily="@font/jostsemibold"
            android:gravity="center"
            android:text="1"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Thông tin student -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStudentName"
                android:fontFamily="@font/jostsemibold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A1D29"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvStudentCode"
                android:fontFamily="@font/mulishbold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: HS001324"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <!-- Status ở bên phải -->
        <TextView
            android:id="@+id/tvAttendanceStatus"
            android:fontFamily="@font/jostsemibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Attended"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#059669" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
