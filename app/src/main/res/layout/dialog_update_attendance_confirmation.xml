<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/mulishextrabold"
            android:gravity="center"
            android:text="Update Attendance"
            android:textColor="#1E293B"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Student Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:background="#F8FAFC"
            android:padding="16dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_student_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mulishbold"
                android:gravity="center"
                android:text="Student Name"
                android:textColor="#1E293B"
                android:textSize="18sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_student_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mulishextrabold"
                android:gravity="center"
                android:text="STU123456"
                android:textColor="#64748B"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Status Change Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_current_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mulishbold"
                android:text="Present"
                android:textColor="#059669"
                android:textSize="16sp"
                android:background="#ECFDF5"
                android:padding="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textColor="#64748B"
                android:textSize="20sp"
                android:layout_marginHorizontal="8dp" />

            <TextView
                android:id="@+id/tv_new_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mulishbold"
                android:text="Absent"
                android:textColor="#DC2626"
                android:textSize="16sp"
                android:background="#FEF2F2"
                android:padding="8dp"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Message -->
        <TextView
            android:id="@+id/tv_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:fontFamily="@font/mulishbold"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="Are you sure you want to update this student's attendance?"
            android:textColor="#64748B"
            android:textSize="16sp" />

        <!-- Buttons Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Cancel Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/jostsemibold"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#64748B"
                android:textSize="18sp"
                app:cornerRadius="16dp"
                app:rippleColor="#F1F5F9"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp" />

            <!-- Confirm Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/jostsemibold"
                android:text="Update"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:backgroundTint="#3B82F6"
                app:cornerRadius="16dp"
                app:rippleColor="#FFFFFF" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
