<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    app:strokeColor="@android:color/transparent"
    app:strokeWidth="0dp"
    android:focusable="true"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Course Name -->
        <TextView
            android:id="@+id/tvSessionCourseName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mulishextrabold"
            android:text="Mathematics - G702"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Time -->
        <TextView
            android:id="@+id/tvSessionDateTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mulishbold"
            android:text="Saturday 10.30 - 12.30 pm"
            android:textSize="14sp"
            android:textColor="#64748B"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvSessionCourseName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnStartNow" />

        <!-- Room -->
        <TextView
            android:id="@+id/tvSessionClassRoom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mulishbold"
            android:text="Beta - BE301"
            android:textSize="14sp"
            android:textColor="#64748B"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvSessionDateTime"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnStartNow" />

        <!-- Start Now Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jostsemibold"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:layout_marginBottom="15dp"
            android:text="Start now"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:backgroundTint="#3B82F6"
            app:cornerRadius="20dp"
            app:layout_constraintBottom_toBottomOf="@id/tvSessionClassRoom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvSessionDateTime"
            app:layout_constraintVertical_bias="1.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
