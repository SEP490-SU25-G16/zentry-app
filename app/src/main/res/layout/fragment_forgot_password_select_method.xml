<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flForgotPasswordRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9FF"
    android:fitsSystemWindows="true">

    <!-- Content chính -->
    <LinearLayout
        android:id="@+id/llForgotPasswordContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="?attr/actionBarSize">

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvForgotPasswordSubtitle"
            android:fontFamily="@font/mulishbold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center"
            android:text="Select which contact details should we use to reset your password"
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- Card chọn Email -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardForgotPasswordOptionEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:id="@+id/llForgotPasswordOptionEmail"
                android:background="#FFFFFF"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/ivForgotPasswordMethodEmail"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_email"
                    app:tint="#167F71" />

                <LinearLayout
                    android:id="@+id/llForgotPasswordEmailTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvForgotPasswordViaEmail"
                        android:fontFamily="@font/mulishbold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Via Email"
                        android:textColor="#666666"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvForgotPasswordEmailAddress"
                        android:fontFamily="@font/mulishbold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="priscilla.frank26@gmail.com"
                        android:textColor="#232B42"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Spacer đẩy nút xuống cuối màn -->
        <Space
            android:id="@+id/spForgotPasswordSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Button Continue -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnForgotPasswordContinue"
            android:paddingLeft="47dp"
            android:fontFamily="@font/jostsemibold"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="50dp"
            android:paddingEnd="7dp"
            android:text="Continue"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            app:backgroundTint="#156CF7"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_arrow_right"
            app:iconGravity="end"
            app:iconPadding="8dp"
            app:iconSize="40dp"
            app:iconTint="@null" />

    </LinearLayout>

    <!-- Toolbar custom overlay -->
    <LinearLayout
        android:id="@+id/llForgotPasswordToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/ivForgotPasswordBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#232B42" />

        <TextView
            android:id="@+id/tvForgotPasswordTitle"
            android:fontFamily="@font/jostsemibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Forgot Password"
            android:textColor="#232B42"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
