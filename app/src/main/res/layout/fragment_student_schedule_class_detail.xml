<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flStudentScheduleClassDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fitsSystemWindows="true">

    <!-- CardView Full Screen -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStudentScheduleClassDetailHeader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:layout_marginHorizontal="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp">

            <!-- Header Info -->
            <TextView
                android:id="@+id/tvStudentScheduleClassDetailSubject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jostsemibold"
                android:text="Mathematics - G701"
                android:textColor="#1E293B"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Class Info Section - Equal Distribution -->
            <LinearLayout
                android:id="@+id/layoutStudentClassInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:weightSum="3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvStudentScheduleClassDetailSubject">

                <!-- Students Count -->
                <TextView
                    android:id="@+id/tvStudentScheduleClassDetailStudentCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/mulishextrabold"
                    android:text="21 Students"
                    android:textAlignment="center"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:drawablePadding="4dp" />

                <!-- Duration -->
                <TextView
                    android:id="@+id/tvStudentScheduleClassDetailDuration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/mulishextrabold"
                    android:text="2 hours 30mins"
                    android:textAlignment="center"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:drawablePadding="4dp" />

                <!-- Room -->
                <TextView
                    android:id="@+id/tvStudentScheduleClassDetailRoom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/mulishextrabold"
                    android:text="BE-201"
                    android:textAlignment="center"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:drawablePadding="4dp" />

            </LinearLayout>

            <!-- Claim Request Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStudentScheduleClassDetailClaimRequest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/mulishextrabold"
                android:paddingVertical="12dp"
                android:text="Claim Request"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:backgroundTint="#A3BFED"
                app:cornerRadius="25dp"
                app:icon="@drawable/ic_claim_request"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutStudentClassInfo" />

            <!-- Final Attendance Title -->
            <TextView
                android:id="@+id/tvStudentFinalAttendanceTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:fontFamily="@font/mulishextrabold"
                android:text="Final Attendance"
                android:textColor="#1E293B"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnStudentScheduleClassDetailClaimRequest" />

            <!-- Student Attendance Item -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStudentAttendanceItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#F8FAFC"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvStudentFinalAttendanceTitle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">


                    <!-- Student Info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStudentName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jostsemibold"
                            android:text="Daniel"
                            android:textColor="#1E293B"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStudentId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/mulishbold"
                            android:text="ID: HS001324"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- Status -->
                    <TextView
                        android:id="@+id/tvStudentAttendanceStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jostsemibold"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="Not yet"
                        android:textColor="#10B981"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Empty Space for scrolling -->
            <View
                android:layout_width="0dp"
                android:layout_height="100dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardStudentAttendanceItem" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Custom Toolbar Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintStudentToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        android:paddingHorizontal="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivStudentScheduleClassDetailBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_background_white"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#1E293B" />

        <TextView
            android:id="@+id/tvStudentScheduleClassDetailTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/jostsemibold"
            android:text="My Class"
            android:textColor="#232B42"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivStudentScheduleClassDetailBack"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/btnStudentScheduleClassDetailNotification"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_background_white"
            android:contentDescription="Notifications"
            android:src="@drawable/ic_notification"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
