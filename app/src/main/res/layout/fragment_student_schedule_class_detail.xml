<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flStudentScheduleClassDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fitsSystemWindows="true">

    <!-- CardView Full Screen -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStudentScheduleClassDetailHeader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:layout_marginHorizontal="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:strokeColor="#FFFFFF"

        app:cardCornerRadius="20dp"  >

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <!-- Header Info -->
                <TextView
                    android:id="@+id/tvStudentScheduleClassDetailSubject"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jostsemibold"
                    android:text=""
                    android:textColor="#1E293B"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Class Info Section -->
                <LinearLayout
                    android:id="@+id/layoutStudentClassInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:weightSum="3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvStudentScheduleClassDetailSubject">

                    <TextView
                        android:id="@+id/tvStudentScheduleClassDetailStudentCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/mulishextrabold"
                        android:text=""
                        android:textAlignment="center"
                        android:textColor="#64748B"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvStudentScheduleClassDetailDuration"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/mulishextrabold"
                        android:text=""
                        android:textAlignment="center"
                        android:textColor="#64748B"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvStudentScheduleClassDetailRoom"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/mulishextrabold"
                        android:text=""
                        android:textAlignment="center"
                        android:textColor="#64748B"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Claim Request Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStudentScheduleClassDetailClaimRequest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/mulishextrabold"
                    android:paddingVertical="12dp"
                    android:text="Claim Request"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    app:backgroundTint="#A3BFED"
                    app:cornerRadius="25dp"
                    app:icon="@drawable/ic_claim_request"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layoutStudentClassInfo" />

                <!-- Final Attendance Title -->
                <TextView
                    android:id="@+id/tvStudentFinalAttendanceTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:fontFamily="@font/mulishextrabold"
                    android:text="Final Attendance"
                    android:textColor="#1E293B"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btnStudentScheduleClassDetailClaimRequest" />

                <!-- Student Info Section -->
                <LinearLayout
                    android:id="@+id/layoutStudentInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvStudentFinalAttendanceTitle">

                    <TextView
                        android:id="@+id/tvStudentName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jostsemibold"
                        android:text=""
                        android:textColor="#1E293B"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStudentId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/mulishbold"
                        android:text=""
                        android:textColor="#64748B"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Attendance Statistics -->
                <LinearLayout
                    android:id="@+id/layoutAttendanceStats"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layoutStudentInfo">

                    <!-- Left Side: Attended/Missed Rounds -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="24dp"
                        android:orientation="vertical"
                        android:gravity="center">

                        <!-- Attended Rounds -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#10B981"
                            app:cardCornerRadius="20dp"
                            app:strokeColor="#FFFFFF"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="220dp"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/mulishextrabold"
                                    android:text="Attended Rounds:"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp" />

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    app:cardBackgroundColor="#FFFFFF"
                                    app:cardCornerRadius="12dp"
                                    app:cardElevation="0dp">

                                    <TextView
                                        android:id="@+id/tvAttendedRounds"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:fontFamily="@font/jostsemibold"
                                        android:gravity="center"
                                        android:text=""
                                        android:textColor="#10B981"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                </com.google.android.material.card.MaterialCardView>

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Missed Rounds -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:cardBackgroundColor="#EF4444"
                            app:cardCornerRadius="20dp"
                            app:strokeColor="#FFFFFF"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="8dp"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/mulishextrabold"
                                    android:text="Missed Rounds:"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp" />

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    app:cardBackgroundColor="#FFFFFF"
                                    app:cardCornerRadius="12dp"
                                    app:cardElevation="0dp">

                                    <TextView
                                        android:id="@+id/tvMissedRounds"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:fontFamily="@font/jostsemibold"
                                        android:text=""
                                        android:textColor="#EF4444"
                                        android:textSize="12sp"
                                        android:gravity="center"
                                        android:textStyle="bold" />

                                </com.google.android.material.card.MaterialCardView>

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <!-- Right Side: Percentage Circle -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <!-- Circular Progress -->
                        <FrameLayout
                            android:layout_width="80dp"
                            android:layout_height="80dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                app:cardBackgroundColor="#10B981"
                                app:cardCornerRadius="40dp"
                                app:strokeColor="#FFFFFF"
                                app:cardElevation="0dp">

                                <TextView
                                    android:id="@+id/tvAttendancePercentage"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:fontFamily="@font/jostsemibold"
                                    android:text=""
                                    android:textColor="#FFFFFF"
                                    android:textSize="18sp"
                                    android:gravity="center"
                                    android:textStyle="bold" />

                            </com.google.android.material.card.MaterialCardView>

                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvTotalRounds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/mulishbold"
                            android:text="Total: 18/25"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- Final Status Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFinalAttendanceStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/jostsemibold"
                    android:paddingHorizontal="32dp"
                    android:paddingVertical="12dp"
                    android:text=""
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#10B981"
                    app:cornerRadius="25dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layoutAttendanceStats" />

                <!-- Bottom Spacer -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btnFinalAttendanceStatus" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>

    </com.google.android.material.card.MaterialCardView>

    <!-- Custom Toolbar Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintStudentToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        android:paddingHorizontal="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivStudentScheduleClassDetailBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_background_white"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#1E293B" />

        <TextView
            android:id="@+id/tvStudentScheduleClassDetailTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/jostsemibold"
            android:text="My Classes"
            android:textColor="#232B42"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivStudentScheduleClassDetailBack"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/btnStudentScheduleClassDetailNotification"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_background_white"
            android:contentDescription="Notifications"
            android:src="@drawable/ic_notification"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/flStudentScheduleClassDetailLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ProgressBar
            android:id="@+id/progressStudentScheduleClassDetailMain"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:cardElevation="8dp"
            android:indeterminateTint="#0961F5"
            android:layout_gravity="center" />
    </FrameLayout>

</FrameLayout>
