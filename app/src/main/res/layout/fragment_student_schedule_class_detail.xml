<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flStudentScheduleClassDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9FF"
    android:fitsSystemWindows="true">

    <!-- ScrollView chứa toàn bộ content, đẩy xuống dưới toolbar overlay -->
    <LinearLayout
        android:id="@+id/svStudentScheduleClassDetailContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="?attr/actionBarSize">

        <!-- Class Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStudentScheduleClassDetailHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="#FFFFFF">

            <LinearLayout
                android:id="@+id/llStudentScheduleClassDetailHeaderContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header row: Grade/Subject + Add button -->
                <LinearLayout
                    android:id="@+id/llStudentScheduleClassDetailHeaderRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/llStudentScheduleClassDetailGradeSubject"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStudentScheduleClassDetailGrade"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/mulishbold"
                            android:text="Grade 07"
                            android:textColor="#F57C00"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStudentScheduleClassDetailSubject"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/jostsemibold"
                            android:text="Mathematics"
                            android:textColor="#232B42"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Stats row -->
                <LinearLayout
                    android:id="@+id/llStudentScheduleClassDetailStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/llStudentScheduleClassDetailDurationContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvStudentScheduleClassDetailDurationLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jostsemibold"
                            android:text="2h 30m"
                            android:textColor="#202244"
                            android:textSize="14sp" />
                    </LinearLayout>


                </LinearLayout>

                <!-- Tabs + ViewPager -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayoutStudentScheduleClassDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@android:color/transparent"
                    android:textAllCaps="false"
                    app:tabIndicatorAnimationMode="elastic"
                    app:tabIndicatorColor="#0961F5"
                    app:tabIndicatorFullWidth="false"
                    app:tabIndicatorHeight="3dp"
                    app:tabRippleColor="#E3F2FD"
                    app:tabSelectedTextColor="#232B42"
                    app:tabTextAppearance="@style/TextAppearance.AppCompat.Body2"
                    app:tabTextColor="#666666" />

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPagerStudentScheduleClassDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Toolbar custom overlay -->
    <LinearLayout
        android:id="@+id/llStudentScheduleClassDetailToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/ivStudentScheduleClassDetailBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#232B42" />

        <TextView
            android:id="@+id/tvStudentScheduleClassDetailTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/jostsemibold"
            android:text="My Classes"
            android:textColor="#232B42"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnStudentScheduleClassDetailNotification"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_notification" />
    </LinearLayout>
</FrameLayout>
