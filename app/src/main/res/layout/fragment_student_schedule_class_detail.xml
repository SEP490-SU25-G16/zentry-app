<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flStudentScheduleClassDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F5F9FF">

    <!-- ScrollView chứa toàn bộ content, đẩy xuống dưới toolbar overlay -->
    <ScrollView
        android:id="@+id/svStudentScheduleClassDetailContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:paddingTop="?attr/actionBarSize"
        android:background="@android:color/transparent">

        <LinearLayout
            android:id="@+id/llStudentScheduleClassDetailContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Class Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStudentScheduleClassDetailHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#FFFFFF"
                app:cardElevation="4dp">

                <LinearLayout
                    android:id="@+id/llStudentScheduleClassDetailHeaderContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header row: Grade/Subject + Add button -->
                    <LinearLayout
                        android:id="@+id/llStudentScheduleClassDetailHeaderRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:id="@+id/llStudentScheduleClassDetailGradeSubject"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStudentScheduleClassDetailGrade"
                                android:fontFamily="@font/mulishbold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Grade 07"
                                android:textColor="#F57C00"
                                android:textSize="14sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvStudentScheduleClassDetailSubject"
                                android:fontFamily="@font/jostsemibold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Mathematics"
                                android:textColor="#232B42"
                                android:textSize="20sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/btnStudentScheduleClassDetailAdd"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_add"
                            android:contentDescription="Add"
                            android:background="?attr/selectableItemBackgroundBorderless"/>
                    </LinearLayout>

                    <!-- Stats row -->
                    <LinearLayout
                        android:id="@+id/llStudentScheduleClassDetailStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:id="@+id/llStudentScheduleClassDetailDurationContainer"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvStudentScheduleClassDetailDurationLabel"
                                android:fontFamily="@font/jostsemibold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2h 30m"
                                android:textSize="14sp"
                                android:textColor="#202244"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvStudentScheduleClassDetailDuration"
                            android:fontFamily="@font/mulishextrabold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:14:50"
                            android:textSize="14sp"
                            android:textColor="#979797"/>
                    </LinearLayout>

                    <!-- Tabs + ViewPager -->
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayoutStudentScheduleClassDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:tabIndicatorColor="#0961F5"
                        app:tabSelectedTextColor="#232B42"
                        app:tabTextColor="#666666"/>

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewPagerStudentScheduleClassDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Toolbar custom overlay -->
    <LinearLayout
        android:id="@+id/llStudentScheduleClassDetailToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@android:color/transparent"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/ivStudentScheduleClassDetailBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="#232B42"/>

        <TextView
            android:id="@+id/tvStudentScheduleClassDetailTitle"
            android:fontFamily="@font/jostsemibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="My Classes"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#232B42"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/btnStudentScheduleClassDetailNotification"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_notification"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>
</FrameLayout>
