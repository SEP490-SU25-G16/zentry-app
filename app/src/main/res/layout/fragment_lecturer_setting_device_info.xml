<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flDeviceInfoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F5F9FF">

    <LinearLayout
        android:id="@+id/llDeviceInfoContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="?attr/actionBarSize"
        android:background="@android:color/transparent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDeviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="48dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:backgroundTint="#FFFFFF">

            <LinearLayout
                android:id="@+id/llDeviceInfoCardContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Device Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/tvDeviceInfoNameLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Device Name"
                        android:textColor="#232B42"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:fontFamily="@font/jostsemibold"/>
                    <TextView
                        android:id="@+id/tvDeviceInfoNameValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#232B42"
                        android:textSize="15sp"
                        android:fontFamily="@font/mulishbold"/>
                </LinearLayout>

                <!-- Registered Date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/tvDeviceInfoDateLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Registered Date"
                        android:textColor="#232B42"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:fontFamily="@font/jostsemibold"/>
                    <TextView
                        android:id="@+id/tvDeviceInfoDateValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#232B42"
                        android:textSize="15sp"
                        android:fontFamily="@font/mulishbold"/>
                </LinearLayout>

                <!-- Model -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/tvDeviceModelLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Model"
                        android:textColor="#232B42"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:fontFamily="@font/jostsemibold"/>
                    <TextView
                        android:id="@+id/tvDeviceModelValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#232B42"
                        android:textSize="15sp"
                        android:fontFamily="@font/mulishbold"/>
                </LinearLayout>

                <!-- Manufacturer -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/tvDeviceManufacturerLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Manufacturer"
                        android:textColor="#232B42"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:fontFamily="@font/jostsemibold"/>
                    <TextView
                        android:id="@+id/tvDeviceManufacturerValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#232B42"
                        android:textSize="15sp"
                        android:fontFamily="@font/mulishbold"/>
                </LinearLayout>

                <!-- Platform -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/tvDevicePlatformLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Platform"
                        android:textColor="#232B42"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:fontFamily="@font/jostsemibold"/>
                    <TextView
                        android:id="@+id/tvDevicePlatformValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#232B42"
                        android:textSize="15sp"
                        android:fontFamily="@font/mulishbold"/>
                </LinearLayout>

                <!-- OS Version -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/tvDeviceOsVersionLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="OS Version"
                        android:textColor="#232B42"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:fontFamily="@font/jostsemibold"/>
                    <TextView
                        android:id="@+id/tvDeviceOsVersionValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#232B42"
                        android:textSize="15sp"
                        android:fontFamily="@font/mulishbold"/>
                </LinearLayout>

                <!-- App Version -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/tvDeviceAppVersionLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="App Version"
                        android:textColor="#232B42"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:fontFamily="@font/jostsemibold"/>
                    <TextView
                        android:id="@+id/tvDeviceAppVersionValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#232B42"
                        android:textSize="15sp"
                        android:fontFamily="@font/mulishbold"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeviceInfoUpdate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Request change"
            android:textAllCaps="true"
            android:fontFamily="@font/jostsemibold"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            app:backgroundTint="#AEACF5"
            app:cornerRadius="28dp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/llDeviceInfoToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@android:color/transparent"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/ivDeviceInfoBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="#232B42"/>

        <TextView
            android:id="@+id/tvDeviceInfoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Device"
            android:textColor="#232B42"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/jostsemibold"/>
    </LinearLayout>
</FrameLayout>
