<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Circle với số thứ tự -->
        <TextView
            android:id="@+id/tvRoundNumber"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/circle_background_round"
            android:fontFamily="@font/jostsemibold"
            android:gravity="center"
            android:text="1"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Nội dung chính - Round title và Attendance trên 1 dòng -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Round Title -->
            <TextView
                android:id="@+id/tvRoundTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/mulishextrabold"
                android:maxLines="1"
                android:text="Round 4"
                android:textColor="#1A1D29"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Attendance -->
            <TextView
                android:id="@+id/tvRoundSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/jostsemibold"
                android:text="18/21 - Attendance"
                android:textColor="#6B7280"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Icon mũi tên - nằm giữa theo chiều dọc -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_arrow_right_round" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
