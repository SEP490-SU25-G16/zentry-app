<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Session Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvSessionNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Session 1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1A1D29"
            android:fontFamily="@font/jostsemibold" />

        <TextView
            android:id="@+id/tvSessionDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jan 15, 2025"
            android:textSize="14sp"
            android:textColor="#6B7280"
            android:fontFamily="@font/mulishbold"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Attendance Status -->
    <TextView
        android:id="@+id/tvAttendanceStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Present"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#059669"
        android:fontFamily="@font/jostsemibold"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:layout_marginStart="8dp" />

</LinearLayout>
