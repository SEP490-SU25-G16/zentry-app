<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clPasswordResetSuccessRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9FF">

    <View
        android:id="@+id/viewPasswordResetSuccessDimOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/llPasswordResetSuccessPopup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:orientation="vertical"
        android:background="@drawable/bg_popup_white"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivPasswordResetSuccessCongratsImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_congratulations"/>

        <TextView
            android:id="@+id/tvPasswordResetSuccessTitle"
            android:fontFamily="@font/jostsemibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_gravity="center_horizontal"
            android:text="Congratulations"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#232B42"/>

        <TextView
            android:id="@+id/tvPasswordResetSuccessMessage"
            android:fontFamily="@font/mulishbold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Your Account is Ready to Use. You will be redirected to the Home Page in a Few Seconds."
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"/>

        <Space
            android:id="@+id/spPasswordResetSuccessSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPasswordResetSuccessSignIn"
            android:fontFamily="@font/jostsemibold"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:paddingLeft="47dp"
            android:paddingEnd="7dp"
            android:text="Sign In"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            app:backgroundTint="#156CF7"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_arrow_right"
            app:iconTint="@null"
            app:iconGravity="end"
            app:iconPadding="8dp"
            app:iconSize="40dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
