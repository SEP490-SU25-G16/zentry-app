<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flStudentSettingDeviceInfoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F5F9FF">

    <!-- Content chính, paddingTop để lùi xuống dưới toolbar overlay -->
    <LinearLayout
        android:id="@+id/llStudentSettingDeviceInfoContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="?attr/actionBarSize"
        android:background="@android:color/transparent">

        <!-- Card View Device Info -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStudentSettingDeviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="48dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:backgroundTint="#FFFFFF">

            <LinearLayout
                android:id="@+id/llStudentSettingDeviceInfoCardContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Name row -->
                <LinearLayout
                    android:id="@+id/llStudentSettingDeviceInfoNameRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvStudentSettingDeviceInfoNameLabel"
                        android:fontFamily="@font/jostsemibold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Name"
                        android:textStyle="bold"
                        android:textColor="#232B42"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/tvStudentSettingDeviceInfoNameValue"
                        android:fontFamily="@font/mulishbold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Samsung S25"
                        android:textColor="#232B42"
                        android:textSize="15sp"/>
                </LinearLayout>

                <!-- ID row -->
                <LinearLayout
                    android:id="@+id/llStudentSettingDeviceInfoIdRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvStudentSettingDeviceInfoIdLabel"
                        android:fontFamily="@font/jostsemibold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ID"
                        android:textStyle="bold"
                        android:textColor="#232B42"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/tvStudentSettingDeviceInfoIdValue"
                        android:fontFamily="@font/mulishbold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SK345680976"
                        android:textColor="#232B42"
                        android:textSize="15sp"/>
                </LinearLayout>

                <!-- Date row -->
                <LinearLayout
                    android:id="@+id/llStudentSettingDeviceInfoDateRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvStudentSettingDeviceInfoDateLabel"
                        android:fontFamily="@font/jostsemibold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Date"
                        android:textStyle="bold"
                        android:textColor="#232B42"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/tvStudentSettingDeviceInfoDateValue"
                        android:fontFamily="@font/mulishbold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JAN 20, 2025  /  15:45"
                        android:textColor="#232B42"
                        android:textSize="15sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Update Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStudentSettingDeviceInfoUpdate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Update"
            android:textAllCaps="true"
            android:fontFamily="@font/jostsemibold"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            app:backgroundTint="#AEACF5"
            app:cornerRadius="28dp"/>
    </LinearLayout>

    <!-- Toolbar custom overlay -->
    <LinearLayout
        android:id="@+id/llStudentSettingDeviceInfoToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@android:color/transparent"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/ivStudentSettingDeviceInfoBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="#232B42"/>

        <TextView
            android:id="@+id/tvStudentSettingDeviceInfoTitle"
            android:fontFamily="@font/jostsemibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Device"
            android:textColor="#232B42"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>
</FrameLayout>
