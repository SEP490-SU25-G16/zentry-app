<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Session Item -->
    <LinearLayout
        android:id="@+id/llSessionItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/llSessionInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSessionTitle"
                android:fontFamily="@font/mulishextrabold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Session - 1"
                android:textColor="#232B42"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/llSessionDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvSessionAttendance"
                    android:fontFamily="@font/jostsemibold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attended"
                    android:textSize="12sp"
                    android:textColor="#167F71"/>

                <TextView
                    android:id="@+id/tvSessionSeparator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="|"
                    android:textSize="12sp"
                    android:textColor="#CCCCCC"/>

                <TextView
                    android:id="@+id/tvSessionDate"
                    android:fontFamily="@font/mulishextrabold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="01/01/2025"
                    android:textSize="12sp"
                    android:textColor="#979797"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:id="@+id/viewSessionDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#949494"/>

</LinearLayout>
