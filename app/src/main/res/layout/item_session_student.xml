<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Session Item -->
    <LinearLayout
        android:id="@+id/llSessionItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Session Title -->
        <TextView
            android:id="@+id/tvSessionTitle"
            android:fontFamily="@font/mulishextrabold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Session - 1"
            android:textColor="#1A1D29"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <!-- Attendance và Date nằm 2 bên -->
        <LinearLayout
            android:id="@+id/llSessionDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <!-- Attendance Status với background -->
            <TextView
                android:id="@+id/tvSessionAttendance"
                android:fontFamily="@font/jostsemibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attended"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/rounded_green_background"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"/>

            <!-- Spacer để đẩy date sang bên phải -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- Date với styling tốt hơn -->
            <TextView
                android:id="@+id/tvSessionDate"
                android:fontFamily="@font/jostsemibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01/01/2025"
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Divider với màu nhẹ hơn -->
    <View
        android:id="@+id/viewSessionDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:background="#E5E7EB"/>

</LinearLayout>
