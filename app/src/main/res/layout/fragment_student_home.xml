<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/svStudentHomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9FF"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/llStudentHomeContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/llStudentHomeHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/ivStudentHomeAvatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_launcher_foreground"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_background" />

            <LinearLayout
                android:id="@+id/llStudentHomeGreetingTexts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvStudentHomeGreeting"
                    android:fontFamily="@font/jostsemibold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hi, Harsha"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#232B42" />

                <TextView
                    android:id="@+id/tvStudentHomeSubGreeting"
                    android:fontFamily="@font/jostsemibold"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Are you ready to teach Today? Let's begin."
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnStudentHomeNotification"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_gravity="center"
                android:src="@drawable/ic_notification" />
        </LinearLayout>

        <!-- Section Title -->
        <TextView
            android:id="@+id/tvStudentHomeSectionTitle"
            android:fontFamily="@font/jostsemibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Classroom"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#232B42"
            android:layout_marginBottom="16dp" />

        <!-- Card 1 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStudentHomeClass1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#FFFFFF"
            app:cardElevation="4dp">

            <LinearLayout
                android:id="@+id/llStudentHomeClass1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivStudentHomeClass1Image"
                    android:layout_gravity="center"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:padding="20dp"
                    android:src="@drawable/ic_congratulations"
                    android:scaleType="centerCrop"
                    android:contentDescription="Mathematics" />

                <LinearLayout
                    android:id="@+id/llStudentHomeClass1Texts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvStudentHomeClass1Title"
                        android:fontFamily="@font/circularstdmedium500"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MATHEMATICS"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#232B42" />

                    <TextView
                        android:id="@+id/tvStudentHomeClass1Teacher"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gayan Iddamalgoda"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvStudentHomeClass1Attendance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Attendance - 100%"
                        android:textColor="#4C4B4B"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvStudentHomeClass1Task"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Task completed"
                        android:textSize="12sp"
                        android:textColor="#4C4B4B"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <ProgressBar
                        android:id="@+id/pbStudentHomeClass1Progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="4dp"
                        android:progress="100"
                        android:progressDrawable="@drawable/rounded_progressbar"
                        android:progressTint="#0961F5" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 2 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStudentHomeClass2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#FFFFFF"
            app:cardElevation="4dp">

            <LinearLayout
                android:id="@+id/llStudentHomeClass2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivStudentHomeClass2Image"
                    android:layout_gravity="center"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:contentDescription="Science"
                    android:padding="20dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_congratulations" />

                <LinearLayout
                    android:id="@+id/llStudentHomeClass2Texts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvStudentHomeClass2Title"
                        android:fontFamily="@font/circularstdmedium500"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SCIENCE"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#232B42" />

                    <TextView
                        android:id="@+id/tvStudentHomeClass2Teacher"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tharidu Diwakara"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvStudentHomeClass2Attendance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Attendance - 90%"
                        android:textSize="12sp"
                        android:textColor="#4C4B4B"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />
                    <TextView
                        android:id="@+id/tvStudentHomeClass2Task"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Task completed"
                        android:textSize="12sp"
                        android:textColor="#4C4B4B"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <ProgressBar
                        android:id="@+id/pbStudentHomeClass2Progress"
                        android:progressDrawable="@drawable/rounded_progressbar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="4dp"
                        android:progress="90"
                        android:progressTint="#0961F5" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
