<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flEditProfileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F5F9FF">

    <!-- ScrollView chứa toàn bộ content, đẩy xuống dưới toolbar overlay -->
    <ScrollView
        android:id="@+id/svEditProfileContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:paddingTop="?attr/actionBarSize"
        android:background="@android:color/transparent">

        <LinearLayout
            android:id="@+id/llEditProfileContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Avatar + edit overlay -->
            <LinearLayout
                android:id="@+id/llEditProfileAvatarRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="24dp">
            </LinearLayout>

            <!-- Full name: chỉ hiển thị -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEditProfileFullName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#FFFFFF"
                app:cardElevation="2dp">

                <TextView
                    android:id="@+id/tvEditProfileFullName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:text="Harsha Kumara"
                    android:textSize="16sp"
                    android:textColor="#232B42"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Username: chỉ hiển thị -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEditProfileUsername"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#FFFFFF"
                app:cardElevation="2dp">

                <TextView
                    android:id="@+id/tvEditProfileUsername"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:text="Harsha"
                    android:textSize="16sp"
                    android:textColor="#232B42"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Date of Birth: chỉ hiển thị -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEditProfileDOB"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#FFFFFF"
                app:cardElevation="2dp">

                <LinearLayout
                    android:id="@+id/llEditProfileDOBContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/ivEditProfileDOBIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="#666666"/>
                    <TextView
                        android:id="@+id/tvEditProfileDOB"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Date of Birth"
                        android:textSize="16sp"
                        android:textColor="#232B42"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Email: chỉ hiển thị -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEditProfileEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#FFFFFF"
                app:cardElevation="2dp">

                <LinearLayout
                    android:id="@+id/llEditProfileEmailContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/ivEditProfileEmailIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_email"
                        app:tint="#666666"/>
                    <TextView
                        android:id="@+id/tvEditProfileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="HarshaKumara98@gmail.com"
                        android:textSize="16sp"
                        android:textColor="#232B42"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Phone: CÓ THỂ SỬA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEditProfilePhone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="32dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#FFFFFF"
                app:cardElevation="2dp">

                <LinearLayout
                    android:id="@+id/llEditProfilePhoneContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/ivEditProfilePhoneIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_phone"/>

                    <EditText
                        android:id="@+id/edtEditProfilePhone"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@android:color/transparent"
                        android:hint="+(91) 987-848-1225"
                        android:textSize="16sp"
                        android:textColor="#232B42"
                        android:inputType="phone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Button Save -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditProfileSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Save"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:backgroundTint="#156CF7"
                app:cornerRadius="28dp"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Toolbar custom overlay -->
    <LinearLayout
        android:id="@+id/llEditProfileToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@android:color/transparent"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/ivEditProfileBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="#232B42"/>

        <TextView
            android:id="@+id/tvEditProfileTitle"
            android:fontFamily="@font/jostsemibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Profile"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#232B42"/>
    </LinearLayout>
</FrameLayout>
